# ============================================
# FlowerStudio — Variabili d'Ambiente
# ============================================
# Copia questo file come .env e inserisci i tuoi valori reali:
#   cp .env.example .env

# --- Server ---
PORT=3000
FRONTEND_URL=http://localhost:3000

# --- Database PostgreSQL (Supabase) ---
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=db.gvbltcrepkaybdsnhweu.supabase.co
DB_PORT=5432
DB_NAME=postgres
DATABASE_URL=postgresql://postgres:your_password_here@db.gvbltcrepkaybdsnhweu.supabase.co:5432/postgres

# --- Autenticazione JWT ---
JWT_SECRET=your_jwt_secret_here

# --- Chatbot AI (Groq) ---
BOT_NAME=Fleur
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Frontend (Vite) ---
# Usato SOLO per lo sviluppo locale del frontend con `npm run dev`
# In Docker, il frontend usa /api tramite il reverse proxy NGINX
VITE_API_URL=/api
